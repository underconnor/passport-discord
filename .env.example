# Use a secret file or the corresponding environment value; never both.
DISCORD_TOKEN_FILE=/run/secrets/discord_bot_token
PASSPORT_DISCORD_SERVICE_TOKEN_FILE=/run/secrets/passport_discord_service_token
DISCORD_APPLICATION_ID=100000000000000001
DISCORD_GUILD_ID=100000000000000002
# Legacy initial verification role; v2 changes use fresh API managedRoleIds.
DISCORD_MEMBER_ROLE_ID=100000000000000003
DISCORD_SETUP_CHANNEL_ID=100000000000000004
PASSPORT_API_BASE_URL=https://api.passport.example/
PASSPORT_WEB_ORIGIN=https://passport.example
PASSPORT_ALLOW_INSECURE_HTTP=false
PASSPORT_STATE_FILE=/data/panel.json
PASSPORT_NICKNAME_STATE_FILE=/data/nicknames.json
BIND_HOST=127.0.0.1
PORT=3102
